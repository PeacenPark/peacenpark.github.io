rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 이메일 목록 - firebase-config.js 의 ADMIN_EMAILS 와 동일하게 유지하세요.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ["jisa861@gmail.com"];
    }

    match /users/{userId} {
      // 본인 문서 또는 관리자만 읽기 가능
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());

      // 최초 가입 시 본인 uid로, approved:false 로만 생성 가능 (자기 자신을 승인 상태로 만들 수 없음)
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.approved == false;

      // 관리자는 모든 수정 가능 (승인/차단)
      // 본인은 가입 완료용 필드만 수정 가능 (approved 는 변경 불가)
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        request.auth.uid == userId &&
                        request.resource.data.approved == resource.data.approved &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['youtube', 'submitted', 'submittedAt']));

      allow delete: if isAdmin();
    }
  }
}
