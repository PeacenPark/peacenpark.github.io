rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 이메일 목록 - firebase-config.js 의 ADMIN_EMAILS 와 동일하게 유지하세요.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ["jisa861@gmail.com"];
    }

    match /users/{userId} {
      // 본인 문서 또는 관리자만 읽기 가능
      allow read: if request.auth != null &&
                     (request.auth.uid == userId || isAdmin());

      // 최초 가입 시 본인 uid로, approved:false 로만 생성 가능 (자기 자신을 승인 상태로 만들 수 없음)
      allow create: if request.auth != null &&
                       request.auth.uid == userId &&
                       request.resource.data.approved == false;

      // 관리자는 모든 수정 가능 (승인/차단)
      // 본인은 가입 완료용 필드만 수정 가능 (approved 는 변경 불가)
      allow update: if isAdmin() ||
                       (request.auth != null &&
                        request.auth.uid == userId &&
                        request.resource.data.approved == resource.data.approved &&
                        request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['youtube', 'submitted', 'submittedAt']));

      allow delete: if isAdmin();
    }

    // ── 앱 개선 요청 ─────────────────────────────────────────
    // 승인된 사용자만 작성 가능. 목록 조회·수정·삭제는 관리자 전용.
    // (작성자도 다른 사람의 제보를 볼 수 없습니다)
    match /feedback/{docId} {
      allow read: if isAdmin();

      allow create: if request.auth != null &&
                       request.resource.data.uid == request.auth.uid &&
                       request.resource.data.status == '접수' &&
                       request.resource.data.text is string &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() <= 2000 &&
                       // 승인된 사용자만 제보 가능
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;

      allow update, delete: if isAdmin();
    }
  }
}
